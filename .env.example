# Firebase Project Configuration (Create .env.local from this template)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=city-emergency-dispatcher.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=city-emergency-dispatcher
VITE_FIREBASE_STORAGE_BUCKET=city-emergency-dispatcher.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=364720673291
VITE_FIREBASE_APP_ID=1:364720673291:web:7a37303cce58f8bcdbad0e
VITE_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key

# App Check & Security
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key
VITE_USE_FIREBASE_EMULATORS=false

# Control Room Coordinates (Default: New Delhi Central Command)
VITE_CONTROL_ROOM_LAT=28.6139
VITE_CONTROL_ROOM_LNG=77.2090

# Geocoding Proxy Endpoint & Provider ('photon' | 'mapbox' | 'google')
VITE_GEOCODER_PROXY_URL=/api/geocode
VITE_GEOCODER_PROVIDER=photon

# Observability (Sentry DSN)
VITE_SENTRY_DSN=
VITE_APP_ENV=development
