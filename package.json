{
  "name": "city-emergency-response-dispatcher",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade real-time City Emergency Response System (CERS) with role-based dispatch, priority triage, and live GIS mapping.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"*.{html,css,md}\"",
    "test": "vitest run tests/unit",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate-firestore-data.mjs",
    "loadtest": "node scripts/load-test.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@playwright/test": "^1.48.2",
    "@types/leaflet": "^1.9.12",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
